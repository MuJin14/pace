{
	admin off
	default_sni hibiscus.wiki

	log {
		output file /var/log/caddy/caddy.log {
			roll_size 10MB
			roll_keep 3
		}
		level INFO
	}
}

# ── 为什么对外只走 8443，不走 443 ────────────────────────────────
#
# 服务器在腾讯云境内、域名未备案 → 入站 80/443 被拦截
# （实测带任意 Host 访问 80 会拿到 401 或 webblock 页）。
# 非标准端口不受影响，所以对外统一用 8443，由 Cloudflare 代理进来。
#
# ── 为什么必须显式指定 tls 证书（真实故障：Cloudflare 525）────────
#
# 服务器上那份 Caddyfile 曾经是：
#     tls { key_type rsa2048 }
# **没有 dns 指令、也没有 cert/key**。Caddy 于是去申请 Let's Encrypt，
# 而 http-01/tls-alpn-01 因 80/443 被拦不可用、DNS-01 又没配 →
# 签发必然失败 → TLS 握手报 alert 80 → Cloudflare 对外返回 **525**，
# 表现为「api.hibiscus.wiki:8443 完全不可用」。
#
# 现在改用 Cloudflare **源站证书**（/certs/origin.crt，覆盖
# *.hibiscus.wiki 与 hibiscus.wiki，有效期到 2041-09-30）：
# 浏览器看到的证书由 Cloudflare 边缘提供，源站这张只在
# Cloudflare → 源站 之间使用，因此**没有续期问题**、也不依赖 CF_API_TOKEN。
#
# ⚠️ 前提：Cloudflare 里这两个域名的 SSL 模式必须是 Full 或 Full (strict)。
# 用 Flexible 的话 Cloudflare 会以 http 回源，8443 这个 HTTPS 站点就访问不到。

(origin_tls) {
	tls /certs/origin.crt /certs/origin.key
}

# ── Let's Encrypt 证书（DNS-01 签发）──────────────────────────────
#
# 与 origin_tls 的关键区别：**客户端信任这张证书**。
#
# 为什么需要它（这是一次完整的故障复盘）：
#   Cloudflare 源站证书只在 Cloudflare → 源站 之间受信，客户端不认，
#   所以对外只能经 Cloudflare 代理；而 Cloudflare 会把国内流量绕到
#   境外节点（实测 LAX/LHR）再回上海 —— 每个请求多花 0.8~3.9 秒。
#
#   根因是：服务器在国内、域名未备案 → 入站 80/443 被拦 →
#   ACME 的 http-01 / tls-alpn-01 都拿不到验证请求。
#   **只有 DNS-01 能走通**（靠改 TXT 记录验证，不碰任何端口）。
#
#   现在用 certbot + Cloudflare DNS 插件签发了正式证书，
#   api / dl 两个域名解析改为「仅 DNS」（灰云）直连源站：
#       0.073 秒（明文）→ 0.113 秒（加密直连），而经 CF 是 0.85~3.9 秒
#
# 续期：certbot.timer 每天检查，自动续期后需要把新证书复制到
#       certs/ 并重载 Caddy（见 docs/deployment.md 的说明）。
(le_tls) {
	tls /certs/le-fullchain.crt /certs/le-privkey.key
}

# ── API：App 用的就是这个（JSON 接口 + /uploads 图片 + /ws 长连接）──
api.hibiscus.wiki:8443 {
	import le_tls

	reverse_proxy app:8080 {
		# ⚠️ 这两个头不能删：后端按「手机号 + IP」限流，
		# 而经 Cloudflare + docker-proxy 之后 remote_addr 是内网地址。
		# 不传真实 IP 的话，全部用户会被算成同一个 IP，
		# 撞到 30 次/5 分钟的上限后**所有人一起被限流**。
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
	}

	log {
		output file /var/log/caddy/access.log {
			roll_size 10MB
			roll_keep 3
		}
	}
}

# ── 官网：静态站点 ──────────────────────────────────────────────
hibiscus.wiki:8443 {
	import origin_tls

	root * /srv/site
	encode gzip

	# ⚠️ 官网域名下也要能打到后端。
	#
	# 站点的下载按钮与版本号都用**相对路径**（`/api/v1/app/...`），
	# 只给 api.hibiscus.wiki 配反代的话，在 hibiscus.wiki 上这些请求会
	# 404 —— 表现是「下载按钮点了没反应」「版本号永远是静态默认值」。
	#
	# 相对路径是刻意的：换域名不用改前端，也不会有跨域问题。
	# 所以两个域名都要把 /api、/uploads、/ws 交给 app。
	handle /api/* {
		reverse_proxy app:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# 头像与聊天图片（<img> 直接加载，必须同域名可达）
	handle /uploads/* {
		reverse_proxy app:8080
	}

	# WebSocket 长连接
	handle /ws {
		reverse_proxy app:8080
	}

	handle {
		# 纯静态站：命中文件就用文件，否则回 index.html
		# （前一条 try_files 让 /about 这类无扩展名的路径也能工作）
		try_files {path} {path}/ /index.html
		file_server
	}

	log {
		output file /var/log/caddy/site-access.log {
			roll_size 10MB
			roll_keep 3
		}
	}
}

# ── 下载域：专门用来分发 APK ──────────────────────────────────────
#
# 为什么不复用 hibiscus.wiki：那个域名指向 Cloudflare Workers（静态托管），
# 而 Workers 的静态资源**有 25 MiB 单文件硬限制**，53.8 MB 的 APK 传不上去
# （实测报错「1 超过 25 MiB 的文件大小限制」）。这是平台限制，不是配置问题。
#
# 所以网页放 Workers，APK 放这里。DNS 里 dl 记录设成「仅 DNS」（灰云）：
# 不走 Cloudflare 代理，因此没有体积限制、也不需要备案。
#
# 用 8443 而不是 80：境内未备案域名的 80/443 会被拦截，8443 不受影响。
# 代价是浏览器会对源站证书提示「不安全」—— 那张证书是 Cloudflare 源站证书，
# 只在 Cloudflare → 源站 之间受信。对「点一下继续」可接受的下载页来说没问题。
dl.hibiscus.wiki:8443 {
	import le_tls

	root * /srv/site
	encode gzip

	# ── 版本接口必须转发到后端 ────────────────────────────────
	#
	# 页面上的版本徽章会去拉 /api/v1/app/version 拿最新版本号。
	# 如果这里不转发，请求会落到下面的 handle{} 回退成 index.html ——
	# 拿到一坨 HTML、JSON 解析失败、徽章永远停在烘焙时的旧值
	# （实测发生过：徽章在 1.4.1 发布后还显示 1.3.0）。
	handle /api/* {
		reverse_proxy app:8080
	}

	# 只读的静态资源：APK 与图片
	handle /downloads/* {
		file_server
	}

	handle {
		# 其它路径给官网首页，避免出现裸 404
		try_files {path} {path}/ /index.html
		file_server
	}
}

# ── 80 端口：仅本机/调试用 ──────────────────────────────────────
:80 {
	root * /srv/site
	try_files {path} {path}/ /index.html
	file_server
}
