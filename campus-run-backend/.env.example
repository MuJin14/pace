# 部署配置模板。复制成 .env 后填写真实值：
#   cp .env.example .env
#
# ⚠️ .env 含密码与密钥，已在 .gitignore 中排除，**绝不要提交**。

# ── 数据库 ──────────────────────────────────────────────
# MySQL root 密码。用强随机串，不要沿用本地开发的 root。
# 生成：openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_strong_db_password

# ── 鉴权 ────────────────────────────────────────────────
# JWT 签名密钥，**至少 32 字节**。泄露 = 任何人都能伪造任意用户登录。
# 生成：openssl rand -base64 48
JWT_SECRET=CHANGE_ME_at_least_32_bytes_random_string

# ── 对外地址 ────────────────────────────────────────────
# 客户端能访问到的后端地址。决定返回的头像 URL。
# 没有域名时填 http://<服务器公网IP>:8080
# 有域名 + Nginx/HTTPS 时填 https://your-domain.com
PUBLIC_BASE_URL=http://CHANGE_ME_server_public_ip:8080

# ── 跨域 ────────────────────────────────────────────────
# 只有跑 Web 版前端才需要；Flutter 原生 App 不受 CORS 限制。
# 收紧到真实域名，不要留 * 。
CORS_ALLOWED_ORIGINS=http://localhost:8081

# ── 端口 ────────────────────────────────────────────────
APP_PORT=8080

# ── 离线推送（可选）────────────────────────────────────
# 没有 Firebase 凭证时保持 false：此时推送内容只写日志，不影响其他功能。
PUSH_ENABLED=false
# PUSH_CREDENTIALS=/app/credentials/firebase-service-account.json
